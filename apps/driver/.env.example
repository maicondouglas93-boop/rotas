# Copie para .env.local. EXPO_PUBLIC_* vai embutido no app: nunca coloque segredos aqui.
# No Expo Go, use o MESMO host do Metro (IP do computador na rede, ex.: 192.168.1.2):
# o Expo Go só permite HTTP sem TLS para o host do servidor de desenvolvimento.
EXPO_PUBLIC_API_URL=http://192.168.1.2:4000/api/v1
