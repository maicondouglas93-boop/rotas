# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=4000

# Local: docker compose (usuário/senha só de desenvolvimento).
# Neon: DATABASE_URL = URL com pooling; DIRECT_DATABASE_URL = URL direta (usada pelas migrations).
DATABASE_URL=postgresql://rotas:rotas_dev@localhost:5432/rotas
DIRECT_DATABASE_URL=postgresql://rotas:rotas_dev@localhost:5432/rotas

# Origens do painel aceitas pelo CORS, separadas por vírgula.
CORS_ORIGENS=http://localhost:3000

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# Autenticação e sessão (JWT_SECRET exige no mínimo 32 caracteres aleatórios).
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_MINUTOS=15
REFRESH_DIAS=30
# Opcional: domínio compartilhado do cookie de refresh em produção (ex.: .exemplo.com.br).
# COOKIE_DOMINIO=
LIMITE_LOGIN_POR_MINUTO=5

# Pasta das fotos de comprovante (só dev/teste; produção usa bucket — docs/adr/0001).
ARMAZENAMENTO_PASTA=.armazenamento

# Seed do primeiro administrador (apenas desenvolvimento/homologação).
SEED_ADMIN_EMAIL=admin@rotas.local
SEED_ADMIN_SENHA=TroqueEstaSenhaLocal123!
