{
  "name": "rotas",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "pnpm --filter @rotas/shared build",
    "dev": "pnpm --parallel --filter api --filter admin --filter @rotas/shared dev",
    "dev:driver": "pnpm --filter driver start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  }
}
